@namespace MsMqApp.Components.Shared
@inherits TreeNodeBase

<div class="tree-node" role="treeitem"
     aria-expanded="@(NodeData.HasChildren ? NodeData.IsExpanded.ToString().ToLower() : null)"
     aria-selected="@NodeData.IsSelected.ToString().ToLower()"
     aria-level="@(NodeData.Level + 1)">

    <div class="tree-node-content @GetSelectedClass()"
         style="padding-left: @GetIndentationStyle()"
         @onclick="OnNodeClickAsync"
         @onclick:stopPropagation="true">

        @if (NodeData.HasChildren)
        {
            <button class="tree-node-toggle"
                    aria-label="@GetToggleAriaLabel()"
                    @onclick="OnToggleClickAsync"
                    @onclick:stopPropagation="true">
                <i class="@GetExpandIconClass()" aria-hidden="true"></i>
            </button>
        }
        else
        {
            <span class="tree-node-spacer"></span>
        }

        @if (!string.IsNullOrWhiteSpace(NodeData.IconClass))
        {
            <i class="@NodeData.IconClass tree-node-icon" aria-hidden="true"></i>
        }

        <span class="tree-node-text @(NodeData.Data is MsMqApp.Models.Domain.QueueInfo queue && queue.IsAccessDenied ? "tree-node-text-unavailable" : string.Empty)"
              title="@(NodeData.Data is MsMqApp.Models.Domain.QueueInfo accessQueue && accessQueue.IsAccessDenied ? "Access denied for this queue" : null)">
            @NodeData.Text
        </span>

        @if (NodeData.Data is MsMqApp.Models.Domain.QueueInfo countQueue)
        {
            var queueNotCounted = NodeData.ViewType != MsMqApp.Models.Enums.QueueViewType.JournalMessages && !countQueue.MessageCountKnown;
            var journalNotCounted = (NodeData.ViewType == MsMqApp.Models.Enums.QueueViewType.JournalMessages ||
                (NodeData.ViewType == MsMqApp.Models.Enums.QueueViewType.Queue && !countQueue.IsSystemQueue && countQueue.QueueType != MsMqApp.Models.Enums.QueueType.Outgoing))
                && !countQueue.JournalMessageCountKnown;
            @if (queueNotCounted)
            {
                <span class="tree-node-count-placeholder"
                      title="@(countQueue.IsAccessDenied ? "Queue count unavailable because access was denied" : "Queue count is not available yet")"
                      aria-label="@(countQueue.IsAccessDenied ? "Queue count unavailable" : "Queue count loading")">-</span>
            }
            @if (journalNotCounted)
            {
                <span class="tree-node-count-placeholder"
                      title="@(countQueue.IsAccessDenied ? "Journal count unavailable because access was denied" : "Journal count is not available yet")"
                      aria-label="@(countQueue.IsAccessDenied ? "Journal count unavailable" : "Journal count loading")">-</span>
            }
        }

        @if (NodeData.BadgeCount.HasValue)
        {
            <span class="tree-node-badge badge bg-secondary"
                  title="@GetBadgeTooltip()"
                  aria-label="@GetBadgeAriaLabel()">
                @FormatBadgeCount(NodeData.BadgeCount.Value)
            </span>
        }

        @if (NodeData.SecondaryBadgeCount.HasValue)
        {
            <span class="tree-node-badge badge bg-info"
                  title="@GetSecondaryBadgeTooltip()"
                  aria-label="@GetSecondaryBadgeAriaLabel()">
                @FormatBadgeCount(NodeData.SecondaryBadgeCount.Value)
            </span>
        }
    </div>

    @if (NodeData.IsExpanded && NodeData.Children.Count > 0)
    {
        <div class="tree-node-children" role="group">
            @foreach (var child in NodeData.Children)
            {
                <TreeNode @key="child.Id"
                          NodeData="@child"
                          OnNodeClick="@OnNodeClick"
                          OnNodeToggle="@OnNodeToggle" />
            }
        </div>
    }
</div>
