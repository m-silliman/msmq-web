@namespace MsMqApp.Components.Shared
@inherits MessageRowBase

<div class="message-row @(ShowStandardColumns ? "message-row-with-standard-columns" : string.Empty) @GetRowClass()" style="@GetGridStyle()" @onclick="OnRowClickAsync">
    <div class="message-row-cell message-cell-select" @onclick:stopPropagation="true">
        <input type="checkbox"
               class="form-check-input"
               checked="@IsChecked"
               @onchange="OnCheckboxChangedAsync"
               aria-label="@GetCheckboxAriaLabel()" />
    </div>

    <div class="message-row-cell message-cell-label" title="@Message.Label">
        @if (OnViewMessage.HasDelegate)
        {
            <button type="button" class="message-viewer-button btn btn-sm btn-link py-0 px-1 me-1" title="Open floating message viewer"
                    aria-label="View message: @Message.Label" @onclick="() => OnViewMessage.InvokeAsync(Message)" @onclick:stopPropagation="true">
                <i class="bi bi-window" aria-hidden="true"></i>
            </button>
        }
        <span class="message-label-text">@Message.Label</span>
        @if (ShowId)
        {
            <span class="message-id-text">@Message.Id</span>
        }
    </div>

    @if (ShowStandardColumns)
    {
        <div class="message-row-cell message-cell-id" title="@Message.Id">
            <span class="message-id-column-text">@Message.Id</span>
        </div>

        <div class="message-row-cell message-cell-size" title="@GetSizeTitle()">
            @Message.FormattedSize
        </div>
    }

    <div class="message-row-cell message-cell-priority">
        <span class="badge @GetPriorityBadgeClass()">
            @GetPriorityText()
        </span>
    </div>

    <div class="message-row-cell message-cell-arrived" title="@Message.ArrivedTime.ToString("yyyy-MM-dd HH:mm:ss")">
        @GetFormattedTime()
    </div>

    @foreach (var column in CustomColumns)
    {
        <div class="message-row-cell custom-message-column-cell" title="@GetCustomValue(column)">
            <span class="custom-message-column-text">@GetCustomValue(column)</span>
        </div>
    }

</div>
