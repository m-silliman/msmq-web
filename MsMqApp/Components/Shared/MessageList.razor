@namespace MsMqApp.Components.Shared
@inherits MessageListBase
@using Microsoft.AspNetCore.Components.Web.Virtualization

<div class="message-list" @ref="ListElement" data-list-version="@ListVersion" data-auto-load="@(CanAutoLoad ? "true" : "false")">
    <div class="message-list-header">
        @if (SelectedQueue != null)
        {
            <div class="selected-queue-breadcrumb">
                <div class="breadcrumb-content">
                    <i class="@GetViewTypeIcon() text-primary" aria-hidden="true"></i>
                    <span class="queue-path">@GetQueueDisplayName()</span>
                    <span class="mx-2 text-muted">›</span>
                    <span class="view-type-label">@GetViewTypeText()</span>
                    @if (ViewType == Models.Enums.QueueViewType.QueueMessages)
                    {
                        <span class="queue-count badge bg-secondary ms-2">@SelectedQueue.MessageCountText</span>
                    }
                    else if (ViewType == Models.Enums.QueueViewType.JournalMessages)
                    {
                        <span class="queue-count badge bg-info ms-2">@SelectedQueue.JournalMessageCountText</span>
                    }
                </div>
                @if (SelectedQueue.QueueType != Models.Enums.QueueType.Private)
                {
                    <small class="queue-type text-muted">@SelectedQueue.QueueType</small>
                }
            </div>
        }
        
        <div class="message-list-toolbar">
            <button type="button"
                    class="search-help-button"
                    @onclick="ToggleSearchHelp"
                    aria-expanded="@ShowSearchHelp"
                    aria-controls="message-search-help"
                    title="Search syntax help">
                <i class="bi bi-question-circle" aria-hidden="true"></i>
                <span class="visually-hidden">Search syntax help</span>
            </button>

            <div class="message-list-search">
                <i class="bi bi-search search-icon" aria-hidden="true"></i>
                <input type="text"
                       class="form-control form-control-sm"
                       placeholder="Search loaded..."
                       title="Use + for AND, | for OR, parentheses for grouping, and quotes for phrases with spaces."
                       @bind="SearchQuery"
                       @bind:event="oninput"
                       @bind:after="OnSearchChangedAsync" />
                @if (!string.IsNullOrWhiteSpace(SearchQuery))
                {
                    <button class="btn btn-sm btn-link clear-search"
                            @onclick="ClearSearchAsync"
                            title="Clear search">
                        <i class="bi bi-x" aria-hidden="true"></i>
                    </button>
                }
            </div>

            <label class="search-body-option" title="Include message bodies in the search. Bodies are loaded for the current page.">
                <input type="checkbox" class="form-check-input" checked="@SearchBody"
                       @onchange="ChangeSearchBodyAsync" disabled="@(IsLoading || IsLoadingMore || IsLoadingBodySearch)" />
                <span>Body</span>
            </label>

            <select class="form-select form-select-sm batch-size-select"
                    value="@BatchSize"
                    aria-label="Messages per load"
                    title="Messages per load"
                    @onchange="ChangeBatchSizeAsync"
                    disabled="@(IsLoading || IsLoadingMore || IsLoadingBodySearch)">
                <option value="100">100</option>
                <option value="200">200</option>
                <option value="500">500</option>
            </select>

            <button type="button"
                    class="message-sort-toggle"
                    @onclick="ToggleTailAsync"
                    disabled="@(IsLoading || IsLoadingMore || IsLoadingBodySearch)"
                    aria-pressed="@ReadFromTail"
                    aria-label="@GetTailSortLabel()"
                    title="@GetTailSortLabel()">
                <i class="bi @(ReadFromTail ? "bi-sort-down-alt" : "bi-sort-up-alt")" aria-hidden="true"></i>
            </button>

            <RefreshControl OnRefresh="@HandleRefreshAsync"
                            AutoRefreshEnabled="@(AutoRefreshEnabled && !IsLoadingMore)"
                            @bind-RefreshIntervalSeconds="@RefreshIntervalSeconds"
                            IsRefreshing="@(IsRefreshing || IsLoading || IsLoadingMore)"
                            @bind-IsPaused="@IsPaused"
                            ShowCountdown="true"
                            ShowRefreshLabel="false"
                            ShowPauseLabel="false" />
        </div>

        @if (ShowSearchHelp)
        {
            <div id="message-search-help" class="search-help-panel" role="note">
                <div class="search-help-title">
                    <i class="bi bi-lightbulb" aria-hidden="true"></i>
                    Search syntax
                </div>
                <table class="search-help-examples">
                    <tbody>
                        <tr>
                            <th scope="row"><code>ABC</code></th>
                            <td>Matches text containing ABC.</td>
                        </tr>
                        <tr>
                            <th scope="row"><code>ABC+EFG</code></th>
                            <td>Matches messages containing both terms.</td>
                        </tr>
                        <tr>
                            <th scope="row"><code>ABC|EFG</code></th>
                            <td>Matches messages containing either term.</td>
                        </tr>
                        <tr>
                            <th scope="row"><code>(ABC|EFG)+ProductionStatus</code></th>
                            <td>Combines groups.</td>
                        </tr>
                        <tr>
                            <th scope="row"><code>&quot;Production Status&quot;</code></th>
                            <td>Searches a phrase including spaces.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="message-list-content">
        @if (IsLoading)
        {
            <div class="message-list-loading">
                <LoadingSpinner Size="SpinnerSize.Medium" Message="Loading messages..." />
            </div>
        }
        else if (FilteredMessages.Count == 0)
        {
            <div class="message-list-empty">
                <i class="@GetViewTypeIcon() text-muted" aria-hidden="true"></i>
                <p class="text-muted mb-0">
                    @if (string.IsNullOrWhiteSpace(SearchQuery))
                    {
                        <text>@GetEmptyStateMessage()</text>
                    }
                    else
                    {
                        <text>No messages match "@SearchQuery"</text>
                    }
                </p>
            </div>
        }
        else
        {
            <div class="message-list-grid" @key="ListVersion" tabindex="0" aria-label="Messages">
                <div class="message-grid-header">
                    <div class="message-grid-cell message-cell-select">
                        <input type="checkbox"
                               class="form-check-input"
                               @onchange="ToggleSelectAllAsync"
                               checked="@AreAllSelected()" />
                    </div>
                    <div class="message-grid-cell message-cell-label" @onclick='() => ToggleSortAsync("Label")'>
                        Label @GetSortIcon("Label")
                    </div>
                    <div class="message-grid-cell message-cell-id" @onclick='() => ToggleSortAsync("Id")'>
                        Id @GetSortIcon("Id")
                    </div>
                    <div class="message-grid-cell message-cell-size" @onclick='() => ToggleSortAsync("Size")'>
                        Size @GetSortIcon("Size")
                    </div>
                    <div class="message-grid-cell message-cell-priority" @onclick='() => ToggleSortAsync("Priority")'>
                        Priority @GetSortIcon("Priority")
                    </div>
                    <div class="message-grid-cell message-cell-arrived" @onclick='() => ToggleSortAsync("ArrivedTime")'>
                        Arrived @GetSortIcon("ArrivedTime")
                    </div>
                </div>

                <Virtualize Items="@FilteredMessages" Context="message" OverscanCount="10">
                    <MessageRow Message="@message"
                                IsSelected="@(SelectedMessage?.Id == message.Id)"
                                IsChecked="@IsMessageSelected(message)"
                                ShowId="false"
                                ShowStandardColumns="true"
                                OnRowClick="@SelectMessageAsync"
                                OnCheckboxChanged="@ToggleMessageSelectionAsync" />
                </Virtualize>
            </div>
        }
    </div>

    @if (!IsLoading && (SelectedQueue != null || HasMore || PagingError != null || IsPaused))
    {
        <div class="message-list-footer" aria-live="polite">
            <small class="message-list-count text-muted">@GetMessageCountText()</small>
            @if (PagingError != null)
            {
                <span class="text-warning">@PagingError</span>
            }
            @if (HasMore)
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="LoadMoreAsync" disabled="@IsLoadingMore">
                    @(IsLoadingMore ? "Loading..." : $"Load next {BatchSize}")
                </button>
            }
            @if (IsPaused)
            {
                <small class="text-muted ms-2">Live refresh paused to keep your place. Use the play button to resume.</small>
            }
        </div>
    }

    @if (SelectedMessages.Count > 0)
    {
        <div class="message-list-footer message-selection-footer" role="status" aria-live="polite">
            <small class="message-selection-count text-muted">
                @SelectedMessages.Count selected
            </small>

            <div class="message-selection-actions">
                <button class="btn btn-sm btn-outline-primary"
                        @onclick="ShowExportSelectedDialog"
                        disabled="@(IsExporting || IsDeleting || MessageOperationsService == null || SelectedQueue == null)"
                        title="Export selected messages">
                    @if (IsExporting)
                    {
                        <i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>
                        <text>Exporting...</text>
                    }
                    else
                    {
                        <i class="bi bi-download me-1" aria-hidden="true"></i>
                        <text>Export</text>
                    }
                </button>

                <button class="btn btn-danger btn-sm"
                        @onclick="ShowDeleteSelectedDialog"
                        disabled="@(IsDeleting || IsExporting)"
                        title="Delete selected messages">
                    @if (IsDeleting)
                    {
                        <i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>
                        <text>Deleting...</text>
                    }
                    else
                    {
                        <i class="bi bi-trash3 me-1" aria-hidden="true"></i>
                        <text>Delete</text>
                    }
                </button>
            </div>
        </div>
    }
</div>

@if (ShowDeleteConfirmation)
{
    <ConfirmationDialog Title="Delete Messages"
                        Message="@($"Are you sure you want to delete {SelectedMessages.Count} message{(SelectedMessages.Count == 1 ? "" : "s")}? This action cannot be undone.")"
                        ConfirmButtonText="Delete"
                        CancelButtonText="Cancel"
                        Severity="DialogSeverity.Danger"
                        @bind-IsOpen="ShowDeleteConfirmation"
                        OnConfirm="@(async (result) => await HandleDeleteConfirmationAsync(true))"
                        OnCancel="@(async (result) => await HandleDeleteConfirmationAsync(false))" />
}

<ExportMessagesDialog @bind-IsOpen="ShowExportConfirmation"
                      MessageCount="@SelectedMessages.Count"
                      @bind-FileName="ExportFileName"
                      IsProcessing="@IsExporting"
                      ErrorMessage="@ExportErrorMessage"
                      OnConfirm="ExportSelectedMessagesAsync"
                      OnCancel="HandleExportCancellationAsync" />
