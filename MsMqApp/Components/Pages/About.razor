@page "/about"
@rendermode InteractiveServer

<PageTitle>About</PageTitle>

<div class="container-fluid px-0">
    <div class="mb-4">
        <h1>About MSMQ Manager</h1>
        <p class="lead mb-0">Monitor and manage Microsoft Message Queuing (MSMQ) across local and remote computers.</p>
    </div>

    <div class="card shadow-sm" style="max-width: 720px;">
        <div class="card-body">
            <h2 class="h5 card-title">Application information</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4">Application</dt>
                <dd class="col-sm-8">MSMQ Manager</dd>

                <dt class="col-sm-4">Purpose</dt>
                <dd class="col-sm-8">Inspect queues, review messages, and perform queue and message management tasks.</dd>

                <dt class="col-sm-4">Platform</dt>
                <dd class="col-sm-8">Microsoft Windows with MSMQ installed</dd>

                <dt class="col-sm-4">Technology</dt>
                <dd class="col-sm-8">Blazor Server on .NET 9</dd>
            </dl>
        </div>
    </div>
</div>
